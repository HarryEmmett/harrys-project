# Optional. Copy to .env only if the defaults clash with something you run.
# docker compose picks this up automatically from this directory.

POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=demo

# Host ports. Change these, not the in-container ports.
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=29092
CONNECT_HOST_PORT=8083
ES_HOST_PORT=9200

# Connector plugin versions, baked in at image build time.
# ES_SINK_VERSION is 'latest' by default because it was never verified against
# a running stack — pin it once you know a version that works, then rebuild:
#   docker compose build --no-cache connect
# CP_VERSION=7.6.1
# DEBEZIUM_VERSION=2.7.4.Final
# ES_SINK_VERSION=latest
